HTTP_MAX_RETRIES=3
CACHE_TTL_SECONDS=3600
MAPPING_MIN_CONFIDENCE=0.50
VALIDATION_MIN_CONFIDENCE=0.5
ENABLE_LLM_VALIDATION=false
ENABLE_CTID_MAPPING=false
CTID_ONLY_MODE=false
LLM_VALIDATION_CONFIDENCE_THRESHOLD=0.8
